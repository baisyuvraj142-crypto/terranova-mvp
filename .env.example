# =================================================================
# TerraNova MVP Configuration (.env)
# Note: All parameters are OPTIONAL. The system operates 100% offline
# and free-tier compliant with realistic regional fallback simulations.
# =================================================================

# Weather Data Provider (Free Tier)
# OPENWEATHER_API_KEY=your_openweather_api_key_here

# SMS Alert Provider (Twilio Free / Trial Tier)
# TWILIO_ACCOUNT_SID=your_twilio_sid_here
# TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
# TWILIO_PHONE_NUMBER=+1234567890

# Fast2SMS Provider (India Free Tier Alternative)
# FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Server Ports
PORT=5000
STREAMLIT_PORT=8501
